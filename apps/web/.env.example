# Exactly one auth provider is active per deployment: "backend" | "supabase"
AUTH_PROVIDER=backend

# --- backend provider ---
API_BASE_URL=http://localhost:8000
SESSION_COOKIE_NAME=session
# Encrypts the session cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# --- supabase provider (public values, inlined at build time) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# --- public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
