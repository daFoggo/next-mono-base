# One identity per deployment (docs/providers.md). Keep only the block you use.
#   AUTH_PROVIDER = neon-auth (default) | demo | supabase | keycloak | fastapi-oauth
#   DATA_PROVIDER = mock (default) | neon          neon REQUIRES AUTH_PROVIDER=neon-auth (config rejects other pairs)
# Demo-only deployment (no provider, no database): AUTH_PROVIDER=demo, DATA_PROVIDER=mock, DEMO_AUTH=true, DEMO_AUTH_SECRET=<32+ chars>

# --- Neon: Neon Auth (managed) + Neon Postgres via Drizzle ---
# Pull the Neon variables into THIS file with `pnpm neon:env` (root). `neon deploy` itself writes the root .env.
AUTH_PROVIDER=neon-auth
DATA_PROVIDER=neon
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=   # yours, 32+ chars: openssl rand -base64 32 (Neon does not provide it)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require   # pooled, for the app
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require  # direct, for migrations
# Schema (once per branch): pnpm --filter @workspace/db neon:migrate
# Google: enable it in Neon Console > Auth (no variable here). Add every app origin to trusted domains.

# --- Supabase Auth + PostgREST/RLS ---
# Local: `pnpm --filter dashboard exec supabase start` prints the URL and publishable key.
# Hosted: Project Settings > API Keys (publishable key only; never a secret/service_role key here).
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Keycloak IDP (d:\Dev_Projects\keycloak-idp: docker compose up -d) ---
# AUTH_PROVIDER=keycloak
# KEYCLOAK_ISSUER=http://localhost:8080/realms/dashboard
# KEYCLOAK_CLIENT_ID=dashboard-app
# KEYCLOAK_CLIENT_SECRET=dashboard-dev-client-secret-at-least-32-chars

# --- FastAPI OAuth2: the backend issues its own JWTs ---
# AUTH_PROVIDER=fastapi-oauth
# API_BASE_URL=http://localhost:8000
# Must be the exact same value as the backend's own JWT_SECRET_KEY (your FastAPI backend .env):
# this service only verifies the signature locally, it does not fetch a JWKS key.
# JWT_SECRET_KEY=change-me-to-a-random-64-char-secret

NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where the logo and "Back to home" on the auth pages go (apps/web).
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# --- Demo login (local/grading only; needs no database) ---
# Shows a "Demo login" button on /sign-in; role is always customer. Secret: 32+ chars, never a real one.
# Works in production too if set: leave both unset on any deployment that must not allow it.
# DEMO_AUTH=true
# DEMO_AUTH_SECRET=replace-with-64-hex-chars (generate with the node command below)

# (packages/db/README.md). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
