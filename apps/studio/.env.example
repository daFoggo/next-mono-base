# One stack per deployment (docs/providers.md). Keep the block of the active AUTH_PROVIDER.

# --- Stack 1: Better Auth + FastAPI (your FastAPI backend: docker compose up -d) ---
AUTH_PROVIDER=better-auth
API_BASE_URL=http://localhost:8000/v1
API_AUDIENCE=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=a-random-secret-key-at-least-32-chars-long
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Stack 2: Supabase Auth + PostgREST/RLS ---
# Local: `pnpm --filter studio exec supabase start` prints the URL and publishable key.
# Hosted: Project Settings > API Keys (publishable key only; never a secret/service_role key here).
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Stack 3: Keycloak IDP (d:\Dev_Projects\keycloak-idp: docker compose up -d) ---
# AUTH_PROVIDER=keycloak
# KEYCLOAK_ISSUER=http://localhost:8080/realms/studio
# KEYCLOAK_CLIENT_ID=studio-app
# KEYCLOAK_CLIENT_SECRET=studio-dev-client-secret-at-least-32-chars

NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where the logo and "Back to home" on the auth pages go (apps/web).
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# --- Demo login (local/grading only; needs no database) ---
# Shows a "Demo login" button on /sign-in; role is always customer. Secret: 32+ chars, never a real one.
# Works in production too if set: leave both unset on any deployment that must not allow it.
# DEMO_AUTH=true
# DEMO_AUTH_SECRET=replace-with-64-hex-chars (generate with the node command below)

# (packages/db/README.md). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
