{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "animate": "pnpm dlx @animate-ui/cli@latest animate all",
    "animate:audit": "pnpm dlx @animate-ui/cli@latest audit"
  },
  "dependencies": {
    "@animate-ui/react": "^2.2.1",
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react": "^0.27.20",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "^14.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.8.0",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turbo/gen": "^2.11.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./provider": "./src/components/animate-ui/provider.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
