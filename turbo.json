{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ],
      "env": [
        "AUTH_PROVIDER",
        "API_BASE_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "NEON_AUTH_BASE_URL",
        "NEON_AUTH_COOKIE_SECRET",
        "NEON_AUTH_LOG_LEVEL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NODE_ENV",
        "EXPOSE_TESTING_API",
        "DEMO_AUTH_SECRET",
        "KEYCLOAK_ISSUER",
        "KEYCLOAK_CLIENT_ID",
        "KEYCLOAK_CLIENT_SECRET",
        "JWT_SECRET_KEY",
        "DASHBOARD_ORIGIN"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "cache": false
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "env": [
        "NEON_TEST_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "E2E_NEON",
        "AUTH_PROVIDER"
      ]
    }
  }
}
